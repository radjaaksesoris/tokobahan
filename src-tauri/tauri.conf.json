{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RAJA Aksesoris",
  "version": "0.1.0",
  "identifier": "com.rajaaksesoris.pos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "RAJA Aksesoris",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBMkI5OTA3MzE1RjMwMTMKUldRVE1GOHhCNWtyR2ljWW9PMVFKSmV6bkRwQko5djFnaldwS0dKRGhuUjYwOHV6T1RTWjB2MEQK",
      "endpoints": [
        "https://github.com/radjaaksesoris/tokobahan/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
